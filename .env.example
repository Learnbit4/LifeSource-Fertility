# Copy to .env.local and fill in. NEVER commit .env.local.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/supsperm

#M-Pesa Daraja (https://developer.safaricom.co.ke). Sandbox values come from your Daraja app.
MPESA_ENV=sandbox                  # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379             # sandbox default; production = your paybill/till
MPESA_PASSKEY=                     # Lipa Na M-Pesa passkey (sandbox passkey is on the Daraja simulator page)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a till
MPESA_PARTY_B=                     # till number if buy-goods; leave empty to use the shortcode
MPESA_CALLBACK_BASE_URL=           # PUBLIC https URL, e.g. your ngrok URL in development
MPESA_CALLBACK_SECRET=             # long random string; protects the callback endpoint
MPESA_MOCK=0                       # 1 = fake payments for local UI testing (ignored in production)
